# Code Danger Detect 推理服务 - CUDA 版本 (transformers + GPU 推理)
# torch cu128 wheel 自带 CUDA 运行时, 宿主机需安装 nvidia-container-toolkit 并注入 libcuda
# 构建(以本目录为 context):
#   docker build -f Dockerfile.cuda -t code-detect:cuda .
# 运行:
#   docker run -d --gpus all -p 8000:8000 -e BASE_MODEL=zjwan461/jarvis-coder \
#     -v ./hf-cache:/home/app/.cache/huggingface code-detect:cuda

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/home/app/.cache/huggingface

RUN useradd -m app && mkdir -p /home/app/.cache/huggingface && chown -R app:app /home/app
COPY --chown=app:app requirements-cuda.txt .
RUN pip install --no-cache-dir -r requirements-cuda.txt

COPY --chown=app:app infer_detect.py api_server.py ./

USER app
EXPOSE 8000

CMD ["python", "api_server.py"]
