# ============================================================================
# j-sandbox 根环境变量示例（docker-compose.yml 统一读取）
# 复制本文件为 .env，然后按需修改对应字段值。
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# 启动：
#   docker compose up -d --build
# ============================================================================

# ---- 镜像版本（三个自编译镜像统一维护）--------------------------------------
# 与 docker-compose.yml 中 image 标签共用；发版时只改这一处。
IMAGE_TAG=1.0.1

# ---- 数据库（mysql 容器与两个 Java 服务共用）--------------------------------
DB_USERNAME=root
DB_PASSWORD=root

# ---- Redis（admin-server 使用；python-sandbox 暂不使用）---------------------
REDIS_PASSWORD=

# ---- 管理端内部接口凭证（批次4 T-0026）--------------------------------------
# /internal/** 通道独立凭证，Header 为 X-Admin-Internal-Token。
# 必须同时注入 sandbox-api 与 admin-server 两侧（compose 已引用同一变量）。
# 留空时 python-sandbox 拒绝一切内部调用；生产环境务必改为随机长串。
ADMIN_INTERNAL_TOKEN=change-me-admin-internal-token

# ---- 沙箱服务 ----------------------------------------------------------------
# 【已废弃】静态 API 鉴权密钥：批次4 起改为 client_api_key 表校验（sk_live_+40hex），
# 本键保留仅作过渡占位，不再参与校验。
SANDBOX_API_KEY=sandbox-secret-key
# 沙箱使用的 Python 镜像（可改为本地构建的镜像或私有仓库地址）
SANDBOX_IMAGE=python:3.12-trixie
# 沙箱容器名称前缀
SANDBOX_CONTAINER_NAME_PREFIX=python-sandbox-
# 会话超时时间（毫秒），默认 24 小时
SANDBOX_SESSION_TIMEOUT_MILLIS=86400000
# 过期会话扫描间隔（毫秒），默认 1 小时
SANDBOX_SESSION_CLEANUP_INTERVAL_MILLIS=3600000
# 限流规则定时拉取间隔（毫秒），默认 60s（批次4 T-0024）
SANDBOX_RATELIMIT_REFRESH_MILLIS=60000
# 限流计数器清理间隔（毫秒），默认 10min
SANDBOX_RATELIMIT_CLEANUP_MILLIS=600000
# sys_config 缺失 ratelimit.anonymous.allowed 键时的本地回落值（默认 false 严格）
SANDBOX_RATELIMIT_ANON_FALLBACK=false
# 最大活跃沙箱容器数量
SANDBOX_MAX_CONTAINERS=10
# 达到上限时的处理策略：reject / evict-oldest
SANDBOX_MAX_CONTAINERS_BEHAVIOR=reject
# 单个容器的最大内存限制（字节），0 表示不限制；512MB = 536870912
SANDBOX_CONTAINER_MEMORY_LIMIT=536870912
# 是否在应用启动时预拉取 Python 镜像（true/false）
SANDBOX_PULL_IMAGE_ON_STARTUP=false
# 是否在应用启动时启动默认容器（true/false）
SANDBOX_CREATE_DEFAULT_CONTAINER_ON_STARTUP=true

# ---- Python 代码安全校验（作用于 /exec/python 接口）--------------------------
SANDBOX_PYTHON_SECURITY_ENABLED=true
SANDBOX_PYTHON_CODE_MAX_LENGTH=102400
# 追加禁用的模块名/内置函数/方法调用（逗号分隔，与默认黑名单合并生效）
SANDBOX_PYTHON_BLOCKED_MODULES=
SANDBOX_PYTHON_BLOCKED_FUNCS=
SANDBOX_PYTHON_BLOCKED_CALLS=

# ---- Docker 守护进程连接 ------------------------------------------------------
# 留空 - 自动检测本地 Docker；tcp://host:2375 - 远程 Docker（需注释 compose 中 socket 挂载）
DOCKER_HOST=
DOCKER_CERT_PATH=
DOCKER_TLS_VERIFY=false
DOCKER_API_VERSION=

# ---- admin-web 对外端口 --------------------------------------------------------
# Nginx 容器监听 80，宿主机映射端口可改（如 80 被占用改为 8081）
ADMIN_WEB_PORT=80
