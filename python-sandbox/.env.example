# ============================================================================
# Python Sandbox 环境变量示例（单服务本地开发参考）
# 注意：全栈 docker-compose 已上移至仓库根目录，统一使用根目录 .env.example
#       （含数据库/Redis/ADMIN_INTERNAL_TOKEN/admin-web 端口等全部键）。
# 启动（在仓库根目录执行）：
#   docker compose up -d --build
# ============================================================================

# ---- 鉴权 -------------------------------------------------------------------
# 【已废弃】静态 API 鉴权密钥：批次4 起 /api/sandbox/** 改为基于 client_api_key 表
# （SHA-256 摘要）的 ApiKey 校验，Header 仍为 X-Api-Key，明文形态 sk_live_+40hex。
# 本键保留仅作过渡占位，不再参与校验。
SANDBOX_API_KEY=sandbox-secret-key

# ---- 管理端内部接口凭证（批次4 T-0026）--------------------------------------
# /internal/** 通道独立凭证，Header 为 X-Admin-Internal-Token。
# 必须与 admin-server 侧 admin.internal.token（ENV ADMIN_INTERNAL_TOKEN）一致。
# 留空时 python-sandbox 拒绝一切内部调用。
ADMIN_INTERNAL_TOKEN=

# ---- 沙箱镜像与容器命名 ------------------------------------------------------
# 沙箱使用的 Python 镜像（可改为本地构建的镜像或私有仓库地址）
SANDBOX_IMAGE=python:3.12-trixie
# 沙箱容器名称前缀
SANDBOX_CONTAINER_NAME_PREFIX=python-sandbox-

# ---- 会话生命周期 -----------------------------------------------------------
# 会话超时时间（毫秒），超过该时间未被使用的会话会被自动清理，默认 24 小时
SANDBOX_SESSION_TIMEOUT_MILLIS=86400000
# 过期会话扫描间隔（毫秒），默认 1 小时
SANDBOX_SESSION_CLEANUP_INTERVAL_MILLIS=3600000

# ---- 限流规则拉取（批次4 T-0024）--------------------------------------------
# 定时从 ratelimit_rule 表拉取规则到本地缓存的间隔（毫秒），默认 60s
SANDBOX_RATELIMIT_REFRESH_MILLIS=60000
# 限流计数器（滑动窗口/令牌桶）清理间隔（毫秒），默认 10min
SANDBOX_RATELIMIT_CLEANUP_MILLIS=600000
# sys_config 缺失 ratelimit.anonymous.allowed 键时的本地回落值（默认 false 严格）
SANDBOX_RATELIMIT_ANON_FALLBACK=false

# ---- 容器数量上限 -----------------------------------------------------------
# 最大活跃沙箱容器数量，默认 10
SANDBOX_MAX_CONTAINERS=10
# 达到上限时的处理策略：reject / evict-oldest
SANDBOX_MAX_CONTAINERS_BEHAVIOR=reject

# ---- 容器资源限制 -----------------------------------------------------------
# 单个容器的最大内存限制（字节），默认 512MB
# 设置为 0 表示不限制
# 常用值示例：
#   256MB = 268435456
#   512MB = 536870912
#   1GB   = 1073741824
#   2GB   = 2147483648
SANDBOX_CONTAINER_MEMORY_LIMIT=536870912

# ---- 代码危险检测策略 CodeGuard（静态校验 + 模型推理）--------------------------
# 策略开关（codeguard.static.enabled / codeguard.model.enabled / codeguard.model.fail-open）
# 以数据库 sys_config 为准，在管理端"系统设置"页面修改即时生效；此处仅基础设施配置。
# 模型推理服务地址（train/infer 的 api_server / vllm_api_server），本地开发默认 localhost:8000
SANDBOX_CODEGUARD_DETECT_BASE_URL=http://localhost:8000
# 推理服务调用超时（毫秒）
SANDBOX_CODEGUARD_DETECT_TIMEOUT_MILLIS=5000

# ---- 启动行为 ---------------------------------------------------------------
# 是否在应用启动时预拉取 Python 镜像（true/false）
#   true  - 服务启动时调用 docker pull，避免首次创建会话延迟
#   false - 延迟到首次创建会话时再拉取（默认）
SANDBOX_PULL_IMAGE_ON_STARTUP=false

# 是否在应用启动时启动默认容器（true/false）
#   true  - 服务启动时调用 docker run
#   false - 服务启动时不调用 docker run
SANDBOX_CREATE_DEFAULT_CONTAINER_ON_STARTUP=true

# ---- Docker 守护进程连接 ----------------------------------------------------
# 连接宿主机 Docker 的方式（通过 docker-java API 连接）：
#   留空                          - 自动检测本地 Docker（优先 socket，其次 DOCKER_HOST 环境变量）
#   unix:///var/run/docker.sock   - 连接本地 Docker（需要保留 docker-compose 中的 socket 挂载）
#   tcp://docker-host:2375        - 连接远程 Docker（需取消 docker-compose 中 socket 挂载并开启远程 API）
#   tcp://docker-host:2376        - TLS 加密的远程 Docker
DOCKER_HOST=
# TLS 证书目录路径（启用 TLS 时必填，目录下应包含 ca.pem、cert.pem、key.pem）
DOCKER_CERT_PATH=
# 是否启用 TLS 验证（true/false）
DOCKER_TLS_VERIFY=false
# Docker API 版本号（留空使用默认版本）
DOCKER_API_VERSION=

# ---- Python 代码安全校验（作用于 /exec/python 接口）-------------------------
# 是否启用 Python 代码静态安全校验（true/false，默认 true）
#   false - 关闭校验，允许所有 Python 代码执行（不推荐）
SANDBOX_PYTHON_SECURITY_ENABLED=true
# Python 代码最大长度（字符数），默认 100KB
#   防止用户上传超大代码导致内存/性能问题
SANDBOX_PYTHON_CODE_MAX_LENGTH=102400
# 追加禁用的模块名（逗号分隔），与默认黑名单合并生效
#   默认拦截：shutil / subprocess / ctypes / cffi / socket / fcntl / pty 等
#   示例：SANDBOX_PYTHON_BLOCKED_MODULES=urllib,requests
SANDBOX_PYTHON_BLOCKED_MODULES=
# 追加禁用的内置函数名（逗号分隔），与默认黑名单合并生效
#   默认拦截：exec / eval / __import__ / compile
#   示例：SANDBOX_PYTHON_BLOCKED_FUNCS=getattr,setattr
SANDBOX_PYTHON_BLOCKED_FUNCS=
# 追加禁用的方法调用（逗号分隔，格式为 module.func），与默认黑名单合并生效
#   默认拦截：os.system / os.remove / shutil.rmtree / subprocess.run 等
#   示例：SANDBOX_PYTHON_BLOCKED_CALLS=os.path.exists,requests.get
SANDBOX_PYTHON_BLOCKED_CALLS=

# ---- 数据库配置（用于 API / 沙箱操作日志持久化）----------------------------
# docker-compose 中已内置 MySQL 容器，默认连接地址为 mysql:3306
# 数据库连接 URL（JDBC 格式）
DB_URL=jdbc:mysql://mysql:3306/sandbox?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
# 数据库用户名（对应 docker-compose 中 MYSQL_ROOT_PASSWORD）
DB_USERNAME=root
# 数据库密码
DB_PASSWORD=root
