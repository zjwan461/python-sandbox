# ============================================================================
# Python Sandbox 环境变量示例
# 复制本文件为 .env，然后按需修改对应字段值。
#   cp .env.example .env
# 启动：
#   docker compose up -d
# ============================================================================

# ---- 鉴权 -------------------------------------------------------------------
# API 鉴权密钥（客户端调用 /exec、/pip 等接口时需要在 Header 中传入 X-API-Key）
SANDBOX_API_KEY=sandbox-secret-key

# ---- 沙箱镜像与容器命名 ------------------------------------------------------
# 沙箱使用的 Python 镜像（可改为本地构建的镜像或私有仓库地址）
SANDBOX_IMAGE=python:3.12-trixie
# 沙箱容器名称前缀
SANDBOX_CONTAINER_NAME_PREFIX=python-sandbox-

# ---- 会话生命周期 -----------------------------------------------------------
# 会话超时时间（毫秒），超过该时间未被使用的会话会被自动清理，默认 24 小时
SANDBOX_SESSION_TIMEOUT_MILLIS=86400000
# 过期会话扫描间隔（毫秒），默认 1 小时
SANDBOX_SESSION_CLEANUP_INTERVAL_MILLIS=3600000

# ---- 容器数量上限 -----------------------------------------------------------
# 最大活跃沙箱容器数量，默认 10
SANDBOX_MAX_CONTAINERS=10
# 达到上限时的处理策略：reject / evict-oldest
SANDBOX_MAX_CONTAINERS_BEHAVIOR=reject

# ---- 启动行为 ---------------------------------------------------------------
# 是否在应用启动时预拉取 Python 镜像（true/false）
#   true  - 服务启动时调用 docker pull，避免首次创建会话延迟
#   false - 延迟到首次创建会话时再拉取（默认）
SANDBOX_PULL_IMAGE_ON_STARTUP=false

# ---- Docker 守护进程连接 ----------------------------------------------------
# 连接宿主机 Docker 的方式：
#   unix:///var/run/docker.sock   - 默认，连接本地 Docker（需要保留 docker-compose 中的 socket 挂载）
#   tcp://docker-host:2375         - 连接远程 Docker（需取消 docker-compose 中 socket 挂载并开启远程 API）
#   tcp://docker-host:2376         - TLS 加密的远程 Docker
DOCKER_HOST=unix:///var/run/docker.sock
